# cp .env.example .env して、パスワードを書き換える

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# WordPress の初期インストール（scripts/setup.sh が使う）
WP_TITLE=Portfolio
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@example.com

# ホストのユーザーの uid / gid（id -u / id -g）
HOST_UID=1000
HOST_GID=1000
